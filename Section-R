                        <text x="230" y="64" fill="#10b981" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">3. FIX</text>
                    </svg>
                `
            },
            radar: {
                tag: 'PILLAR 04 • THREAT RADAR & SOC',
                tagClass: 'bg-cyber-danger/15 text-cyber-danger',
                borderClass: 'border-cyber-danger',
                panelBorder: 'border-cyber-danger/50',
                title: 'Threat Radar & 24/7 Defense',
                caption: 'LIVE AI MONITORING → INSTANT ALERT → AUTO-LOCKDOWN',
                captionColor: 'text-cyber-danger',
                points: [
                    'Monitors computers and servers 24/7 like a live security radar.',
                    'Uses AI to detect viruses, ransomware, or unusual login attempts.',
                    'Automatically isolates infected devices in milliseconds.'
                ],
                example: 'Bank fraud radar immediately freezing an account when someone logs in from an unknown country.',
                svg: `
                    <svg class="w-full max-w-xs h-36" viewBox="0 0 280 120" fill="none">
                        <circle cx="65" cy="60" r="36" stroke="#ff2a5f" stroke-width="2" stroke-dasharray="4 4"/>
