<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyber Security | USP Multan — Made by Subhan</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        cyber: {
                            bg: '#060b19',
                            card: '#0d152a',
                            border: '#1e293b',
                            cyan: '#00f0ff',
                            emerald: '#10b981',
                            danger: '#ff2a5f',
                            gold: '#f5b800',
                            navy: '#0a2240'
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'float': 'float 4s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom subtle scrollbars & glow utilities */
        body {
            background-color: #060b19;
            color: #f8fafc;
            overflow-x: hidden;
        }
        .cyber-grid-bg {
            background-image: 
                linear-gradient(to right, rgba(0, 240, 255, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 240, 255, 0.04) 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .glow-cyan {
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.2);
        }
        .glow-gold {
            box-shadow: 0 0 20px rgba(245, 184, 0, 0.25);
        }
        .glow-danger {
            box-shadow: 0 0 25px rgba(255, 42, 95, 0.25);
        }
        .glow-emerald {
            box-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
        }
        /* Animated SVG path dash */
        @keyframes flowPacket {
            to {
                stroke-dashoffset: -40;
            }
        }
        .packet-line {
            stroke-dasharray: 8 12;
            animation: flowPacket 1.2s linear infinite;
        }
    </style>
</head>
<body class="cyber-grid-bg min-h-screen flex flex-col justify-between selection:bg-cyber-cyan selection:text-cyber-bg">

    <!-- ==================== TOP NAVBAR (USP LOGO TOP-LEFT & MADE BY SUBHAN) ==================== -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#060b19]/85 border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- TOP-LEFT: University of Southern Punjab (USP) Logo + Label -->
            <div class="flex items-center gap-3 sm:gap-4">
                <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full p-0.5 bg-gradient-to-tr from-cyber-gold via-yellow-300 to-cyber-gold glow-gold flex-shrink-0 overflow-hidden">
                    <!-- Uses uploaded 'images (2).jfif' first, with an instant high-detail USP Multan SVG fallback -->
                    <img 
                        src="images (2).jfif" 
                        alt="University of Southern Punjab Logo" 
                        class="w-full h-full object-cover rounded-full bg-white"
                        onerror="this.style.display='none'; document.getElementById('usp-fallback-svg').classList.remove('hidden');"
                    >
                    <!-- High-Detail Crisp SVG Replica of USP Multan 2010 Seal -->
                    <svg id="usp-fallback-svg" class="hidden w-full h-full rounded-full" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <path id="topArc" d="M 24,100 A 76,76 0 1,1 176,100" />
                            <path id="bottomArc" d="M 22,105 A 78,78 0 0,0 178,105" />
                        </defs>
                        <!-- Outer Gold Ring -->
                        <circle cx="100" cy="100" r="98" fill="#f5b800" stroke="#0a2240" stroke-width="2"/>
                        <!-- Inner Deep Navy Circle -->
                        <circle cx="100" cy="100" r="68" fill="#0a2240" stroke="#f5b800" stroke-width="2"/>
                        <!-- Inner Thin Gold Ring -->
                        <circle cx="100" cy="100" r="46" fill="none" stroke="#f5b800" stroke-width="1.5"/>
                        
                        <!-- Outer Ring Curved Text -->
                        <text fill="#0a2240" font-family="Inter, sans-serif" font-weight="800" font-size="13.2" letter-spacing="1.1">
                            <textPath href="#topArc" startOffset="50%" text-anchor="middle">UNIVERSITY OF SOUTHERN PUNJAB</textPath>
                        </text>
                        <text fill="#0a2240" font-family="Inter, sans-serif" font-weight="800" font-size="14" letter-spacing="2">
                            <textPath href="#bottomArc" startOffset="50%" text-anchor="middle">PAKISTAN</textPath>
                        </text>
                        
                        <!-- Multan & 2010 -->
                        <text x="100" y="163" fill="#0a2240" font-family="Inter, sans-serif" font-weight="800" font-size="13" text-anchor="middle" letter-spacing="1">MULTAN</text>
                        <text x="100" y="143" fill="#f5b800" font-family="Inter, sans-serif" font-weight="700" font-size="11.5" text-anchor="middle">2010</text>
                        
                        <!-- Center USP Letters -->
                        <text x="100" y="83" fill="#f5b800" font-family="Georgia, serif" font-weight="800" font-size="25" text-anchor="middle" letter-spacing="1.5">USP</text>
                        
                        <!-- Open Book / Shield Emblem -->
                        <path d="M 74,90 Q 100,96 126,90 L 126,120 Q 100,128 74,120 Z" fill="#f5b800"/>
                        <path d="M 100,93 L 100,124" stroke="#0a2240" stroke-width="1.5"/>
                        <!-- Geometric Calligraphy Motif -->
                        <rect x="91" y="99" width="18" height="16" rx="2" fill="none" stroke="#0a2240" stroke-width="2" transform="rotate(45 100 107)"/>
                        <circle cx="100" cy="107" r="4" fill="#0a2240"/>
                    </svg>
                </div>

                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs sm:text-sm font-extrabold tracking-wider uppercase text-cyber-gold">USP Multan</span>
                        <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-cyber-cyan"></span>
                        <span class="hidden sm:inline-block text-xs font-mono text-slate-400">DEPT. OF CYBER SECURITY</span>
                    </div>
                    <h1 class="text-sm sm:text-lg font-bold text-white leading-tight">University of Southern Punjab</h1>
                </div>
            </div>

            <!-- TOP-RIGHT: Prominent "Made by Subhan" Creator Pill -->
            <div class="flex items-center gap-3">
                <div class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-gradient-to-r from-cyber-card to-slate-900 border border-cyber-gold/50 glow-gold flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-cyber-emerald animate-ping"></span>
                    <span class="text-xs sm:text-sm font-bold tracking-wide text-white">
                        Made by <span class="text-cyber-gold font-extrabold">Subhan</span>
                    </span>
                </div>
            </div>
        </div>
    </header>

    <!-- ==================== MAIN PRESENTATION CONTENT ==================== -->
    <main class="flex-grow">

        <!-- 1. VISUAL HERO SECTION WITH INTERACTIVE THREAT VS DEFENSE SHIELD -->
        <section class="relative overflow-hidden border-b border-slate-800/80">
            <!-- Animated Particle Network Canvas -->
            <canvas id="networkCanvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-55"></canvas>

            <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                    
                    <!-- Left Column: Ultra-Clean Headline + Visual Toggle -->
                    <div class="lg:col-span-6 text-center lg:text-left space-y-6">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 text-cyber-cyan text-xs font-mono uppercase tracking-widest">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            Protect Your Data And Yourself!
                        </div>

                        <h2 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white">
                            CYBER <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyber-cyan to-cyber-emerald">SECURITY</span>
                        </h2>

                        <!-- Minimal 1-Line Tagline -->
                        <p class="text-base sm:text-xl text-slate-300 font-medium max-w-xl mx-auto lg:mx-0">
                            Protecting Networks, Data & Digital Identity from Cyber Attacks.
                        </p>

                        <!-- Interactive Visual Mode Switcher: Defense Active vs Under Attack -->
                        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-4">
                            <button id="btn-defense-mode" onclick="setHeroState('defense')" class="px-5 py-3 rounded-xl font-bold text-sm flex items-center gap-2.5 bg-cyber-emerald text-slate-950 shadow-lg shadow-cyber-emerald/25 transition-all scale-105">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                FireWall ON (Safe)
                            </button>
                            <button id="btn-attack-mode" onclick="setHeroState('attack')" class="px-5 py-3 rounded-xl font-bold text-sm flex items-center gap-2.5 bg-cyber-card text-slate-300 border border-slate-700 hover:border-cyber-danger transition-all">
                                <svg class="w-5 h-5 text-cyber-danger" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                FireWall Off (Unsafe)
                            </button>
                        </div>

                        <!-- Visual Icon Badges (Zero Paragraphs) -->
                        <div class="grid grid-cols-3 gap-3 pt-4 max-w-md mx-auto lg:mx-0">
                            <div class="p-3 rounded-2xl bg-cyber-card/90 border border-slate-800 text-center">
                                <div class="text-cyber-cyan font-mono font-bold text-lg sm:text-xl">256-BIT</div>
                                <div class="text-[11px] uppercase tracking-wider text-slate-400">Encryption</div>
                            </div>
                            <div class="p-3 rounded-2xl bg-cyber-card/90 border border-slate-800 text-center">
                                <div class="text-cyber-emerald font-mono font-bold text-lg sm:text-xl">24 / 7</div>
                                <div class="text-[11px] uppercase tracking-wider text-slate-400">Monitoring</div>
                            </div>
                            <div class="p-3 rounded-2xl bg-cyber-card/90 border border-slate-800 text-center">
                                <div class="text-cyber-gold font-mono font-bold text-lg sm:text-xl">ZERO</div>
                                <div class="text-[11px] uppercase tracking-wider text-slate-400">Trust Model</div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Large Interactive Cyber Shield SVG Graphic -->
                    <div class="lg:col-span-6 flex justify-center">
                        <div id="hero-graphic-box" class="relative w-full max-w-md aspect-square rounded-3xl bg-cyber-card/80 border border-cyber-cyan/30 glow-cyan p-6 flex flex-col items-center justify-center transition-all duration-500">
                            
                            <!-- Status Pill inside Graphic -->
                            <div id="hero-status-pill" class="absolute top-5 px-4 py-1.5 rounded-full bg-cyber-emerald/20 border border-cyber-emerald text-cyber-emerald text-xs font-mono font-bold tracking-wider uppercase flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyber-emerald animate-ping"></span>
                                SYSTEM PROTECTED
                            </div>

                            <!-- Detailed Animated Cyber Shield & Globe SVG -->
                            <svg id="hero-shield-svg" class="w-64 h-64 sm:w-72 sm:h-72 animate-float" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Rotating Outer Radar Ring -->
                                <circle cx="150" cy="150" r="130" stroke="#00f0ff" stroke-width="1.5" stroke-dasharray="12 8" opacity="0.45">
                                    <animateTransform attributeName="transform" type="rotate" from="0 150 150" to="360 150 150" dur="20s" repeatCount="indefinite"/>
                                </circle>
                                <circle cx="150" cy="150" r="108" stroke="#10b981" stroke-width="2" stroke-dasharray="40 15" opacity="0.6">
                                    <animateTransform attributeName="transform" type="rotate" from="360 150 150" to="0 150 150" dur="14s" repeatCount="indefinite"/>
                                </circle>

                                <!-- Central Shield Body -->
                                <path id="shield-body" d="M150 42L232 76V146C232 202 197 246 150 264C103 246 68 202 68 146V76L150 42Z" fill="#0a2240" stroke="#00f0ff" stroke-width="4"/>
                                <path d="M150 56L218 85V145C218 193 189 231 150 247C111 231 82 193 82 145V85L150 56Z" fill="#060b19" stroke="#10b981" stroke-width="2" opacity="0.8"/>

                                <!-- Padlock Icon Inside Shield -->
                                <rect x="122" y="138" width="56" height="46" rx="10" fill="#10b981" id="shield-lock-body"/>
                                <path id="shield-lock-shackle" d="M133 138V121C133 111.6 140.6 104 150 104C159.4 104 167 111.6 167 121V138" stroke="#00f0ff" stroke-width="6" stroke-linecap="round"/>
                                <circle cx="150" cy="158" r="5" fill="#060b19"/>
                                <path d="M150 162V171" stroke="#060b19" stroke-width="4" stroke-linecap="round"/>

                                <!-- Orbiting Satellite Nodes -->
                                <circle cx="150" cy="20" r="6" fill="#00f0ff"/>
                                <circle cx="280" cy="150" r="6" fill="#f5b800"/>
                                <circle cx="150" cy="280" r="6" fill="#10b981"/>
                                <circle cx="20" cy="150" r="6" fill="#00f0ff"/>
                            </svg>

                            <!-- Visual Bottom Caption -->
                            <div id="hero-visual-caption" class="absolute bottom-5 text-center font-mono text-xs text-slate-300">
                                FIREWALL: <span class="text-cyber-emerald font-bold">ACTIVE</span> &bull; INTRUSIONS: <span class="text-cyber-cyan font-bold">0</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 2. INTERACTIVE VISUAL FLOW DIAGRAM (HOW CYBER DEFENSE WORKS) -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
            <div class="text-center mb-8">
                <span class="text-xs font-mono uppercase tracking-widest text-cyber-cyan">Visual Architecture</span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">How Security Blocks Works</h3>
                <p class="text-xs sm:text-sm text-slate-400 mt-1">Tap any icon below to inspect its visual role</p>
            </div>

            <!-- Interactive SVG Pipeline Card -->
            <div class="rounded-3xl bg-cyber-card border border-slate-800 p-6 sm:p-10 shadow-2xl">
                <div class="grid grid-cols-1 md:grid-cols-7 items-center gap-4 text-center">
                    
                    <!-- Node 1: Threat Source -->
                    <button onclick="selectFlowNode('threat')" id="node-threat" class="flow-node group p-4 rounded-2xl bg-[#091022] border-2 border-cyber-danger/60 hover:border-cyber-danger transition-all flex flex-col items-center">
                        <div class="w-16 h-16 rounded-2xl bg-cyber-danger/15 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                            <!-- Hacker / Malware SVG -->
                            <svg class="w-9 h-9 text-cyber-danger" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/></svg>
                        </div>
                        <span class="font-bold text-white text-sm">1. Cyber Threat</span>
                        <span class="text-[11px] font-mono text-cyber-danger mt-1">Malware / Phishing</span>
                    </button>

                    <!-- Animated Connector 1 -->
                    <div class="hidden md:flex justify-center">
                        <svg class="w-full h-8" viewBox="0 0 80 24">
                            <line x1="0" y1="12" x2="72" y2="12" stroke="#ff2a5f" stroke-width="3" class="packet-line"/>
                            <polygon points="70,6 80,12 70,18" fill="#ff2a5f"/>
                        </svg>
                    </div>

                    <!-- Node 2: Firewall Filter -->
                    <button onclick="selectFlowNode('firewall')" id="node-firewall" class="flow-node group p-4 rounded-2xl bg-[#091022] border-2 border-slate-700 hover:border-cyber-gold transition-all flex flex-col items-center">
                        <div class="w-16 h-16 rounded-2xl bg-cyber-gold/15 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                            <!-- Brick Firewall SVG -->
                            <svg class="w-9 h-9 text-cyber-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/></svg>
                        </div>
                        <span class="font-bold text-white text-sm">2. Firewall</span>
                        <span class="text-[11px] font-mono text-cyber-gold mt-1">Blocks Bad Traffic</span>
                    </button>

                    <!-- Animated Connector 2 -->
                    <div class="hidden md:flex justify-center">
                        <svg class="w-full h-8" viewBox="0 0 80 24">
                            <line x1="0" y1="12" x2="72" y2="12" stroke="#f5b800" stroke-width="3" class="packet-line"/>
                            <polygon points="70,6 80,12 70,18" fill="#f5b800"/>
                        </svg>
                    </div>

                    <!-- Node 3: Encryption Tunnel -->
                    <button onclick="selectFlowNode('encryption')" id="node-encryption" class="flow-node group p-4 rounded-2xl bg-[#091022] border-2 border-slate-700 hover:border-cyber-cyan transition-all flex flex-col items-center">
                        <div class="w-16 h-16 rounded-2xl bg-cyber-cyan/15 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                            <!-- Key / Encryption SVG -->
                            <svg class="w-9 h-9 text-cyber-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                        </div>
                        <span class="font-bold text-white text-sm">3. Encryption</span>
                        <span class="text-[11px] font-mono text-cyber-cyan mt-1">Locks Data Code</span>
                    </button>

                    <!-- Animated Connector 3 -->
                    <div class="hidden md:flex justify-center">
                        <svg class="w-full h-8" viewBox="0 0 80 24">
                            <line x1="0" y1="12" x2="72" y2="12" stroke="#10b981" stroke-width="3" class="packet-line"/>
                            <polygon points="70,6 80,12 70,18" fill="#10b981"/>
                        </svg>
                    </div>

                    <!-- Node 4: Secure Server -->
                    <button onclick="selectFlowNode('server')" id="node-server" class="flow-node group p-4 rounded-2xl bg-[#091022] border-2 border-slate-700 hover:border-cyber-emerald transition-all flex flex-col items-center">
                        <div class="w-16 h-16 rounded-2xl bg-cyber-emerald/15 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                            <!-- Secure Server SVG -->
                            <svg class="w-9 h-9 text-cyber-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
                        </div>
                        <span class="font-bold text-white text-sm">4. Safe Data</span>
                        <span class="text-[11px] font-mono text-cyber-emerald mt-1">100% Protected</span>
                    </button>
                </div>

                <!-- Visual Node Spotlight Bar (Crisp 1-line visual badge) -->
                <div id="flow-detail-banner" class="mt-8 p-4 rounded-2xl bg-[#060b19] border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span id="flow-badge" class="px-3 py-1 rounded-lg bg-cyber-danger/20 text-cyber-danger font-mono text-xs font-bold uppercase">STEP 1</span>
                        <span id="flow-title" class="text-sm sm:text-base font-bold text-white">Hackers send malicious packets or fake links.</span>
                    </div>
                    <span id="flow-metric" class="font-mono text-xs px-3 py-1.5 rounded-full bg-slate-900 text-cyber-cyan border border-slate-700">
                        RISK LEVEL: HIGH
                    </span>
                </div>
            </div>
        </section>

        <!-- 3. FOUR CORE PILLARS (VISUAL GRAPHIC CARDS) -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
            <div class="text-center mb-8">
                <span class="text-xs font-mono uppercase tracking-widest text-cyber-gold">Core Domains</span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">4 Pillars of Cyber Security</h3>
                <p class="text-xs sm:text-sm text-slate-400 mt-1">Click any pillar card to view visual explanation &amp; real-world example</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                
                <!-- Card 1: Network Security -->
                <button type="button" onclick="selectPillar('network')" id="pillar-card-network" class="pillar-card group rounded-3xl bg-cyber-card border-2 border-cyber-cyan p-6 flex flex-col items-center text-center transition-all hover:-translate-y-1 focus:outline-none">
                    <div class="w-full h-36 rounded-2xl bg-[#060b19] mb-5 flex items-center justify-center relative overflow-hidden">
