        function selectPillar(key) {
            const data = pillarDetails[key];
            if (!data) return;

            // Reset all 4 card borders, then highlight selected card
            const allCards = ['network', 'crypto', 'hacking', 'radar'];
            allCards.forEach(id => {
                const el = document.getElementById(`pillar-card-${id}`);
                if (el) {
                    el.classList.remove('border-cyber-cyan', 'border-cyber-emerald', 'border-cyber-gold', 'border-cyber-danger', '-translate-y-1');
                    el.classList.add('border-slate-800');
                }
            });

            const activeCard = document.getElementById(`pillar-card-${key}`);
            if (activeCard) {
                activeCard.classList.remove('border-slate-800');
                activeCard.classList.add(data.borderClass, '-translate-y-1');
            }

            // Update panel styling & content
            const panel = document.getElementById('pillar-detail-panel');
            panel.className = `mt-8 rounded-3xl bg-cyber-card border-2 ${data.panelBorder} p-6 sm:p-8 shadow-2xl transition-all duration-300`;

            const tagEl = document.getElementById('pillar-tag');
            tagEl.className = `px-3 py-1 rounded-full font-mono text-xs font-bold uppercase ${data.tagClass}`;
            tagEl.textContent = data.tag;

            document.getElementById('pillar-heading').textContent = data.title;
            document.getElementById('pillar-visual-graphic').innerHTML = data.svg;

            const capEl = document.getElementById('pillar-visual-caption');
            capEl.className = `mt-3 font-mono text-xs uppercase tracking-wider ${data.captionColor}`;
            capEl.textContent = data.caption;

            const pointsList = document.getElementById('pillar-points');
            pointsList.innerHTML = data.points.map(pt => `
                <li class="flex items-start gap-2.5">
                    <span class="w-5 h-5 rounded-full bg-cyber-emerald/20 text-cyber-emerald flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">&#10003;</span>
                    <span>${pt}</span>
                </li>
            `).join('');

            document.getElementById('pillar-example').textContent = data.example;
        }

        // 3. Live Encryption Visualizer (Text -> Hex Cipher)
        function updateEncryption() {
            const input = document.getElementById('plainInput').value || 'USP';
            const output = document.getElementById('cipherOutput');
            const hex = Array.from(input)
                .map(char => (char.charCodeAt(0) ^ 42).toString(16).toUpperCase().padStart(2, '0'))
                .join(' ');
            output.textContent = hex;
        }

        // 4. Visual Password Strength Meter
        function checkPasswordVisual() {
            const val = document.getElementById('passInput').value;
            const bar = document.getElementById('passStrengthBar');
            const label = document.getElementById('passStrengthLabel');
            const time = document.getElementById('passCrackTime');

            let score = 0;
            if (val.length >= 6) score += 25;
            if (val.length >= 10) score += 25;
            if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score += 25;
            if (/[^A-Za-z0-9]/.test(val)) score += 25;

            bar.style.width = `${Math.max(score, 10)}%`;

            if (score <= 25) {
                bar.className = 'h-full bg-cyber-danger transition-all duration-300';
                label.className = 'text-xs font-mono font-bold text-cyber-danger uppercase';
                label.textContent = 'WEAK (EASY TO HACK)';
                time.textContent = 'Crack Time: Instant';
            } else if (score <= 75) {
                bar.className = 'h-full bg-cyber-gold transition-all duration-300';
                label.className = 'text-xs font-mono font-bold text-cyber-gold uppercase';
                label.textContent = 'MEDIUM PROTECTION';
                time.textContent = 'Crack Time: 3 Days';
            } else {
                bar.className = 'h-full bg-cyber-emerald transition-all duration-300';
                label.className = 'text-xs font-mono font-bold text-cyber-emerald uppercase';
                label.textContent = 'STRONG SHIELD';
                time.textContent = 'Crack Time: 400+ Years';
            }
        }

        // 5. Subtle Animated Cyber Network Canvas Background
        window.onload = function() {
            selectPillar('network');
            updateEncryption();
            checkPasswordVisual();

            const canvas = document.getElementById('networkCanvas');
            const ctx = canvas.getContext('2d');
            let width, height, particles;

            function resize() {
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
                initParticles();
            }

            function initParticles() {
                const count = Math.min(Math.floor(width / 25), 45);
                particles = Array.from({ length: count }, () => ({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: (Math.random() - 0.5) * 0.6,
                    vy: (Math.random() - 0.5) * 0.6,
                    r: Math.random() * 2 + 1.5
                }));
            }

            function draw() {
                ctx.clearRect(0, 0, width, height);
                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0 || p.x > width) p.vx *= -1;
                    if (p.y < 0 || p.y > height) p.vy *= -1;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = '#00f0ff';
                    ctx.fill();

                    for (let j = i + 1; j < particles.length; j++) {
                        const p2 = particles[j];
                        const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
                        if (dist < 130) {
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.strokeStyle = `rgba(0, 240, 255, ${0.22 * (1 - dist / 130)})`;
                            ctx.lineWidth = 1;
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(draw);
            }

            window.addEventListener('resize', resize);
            resize();
            draw();
        };
    </script>
